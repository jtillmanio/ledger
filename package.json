{
  "name": "ledger",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:views": "node scripts/sql.mjs live etl/views.sql",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:db:reset": "node scripts/test-db.mjs",
    "extract": "py etl/extract.py --comics etl/data/Comics.xlsx --books etl/data/Books.xlsx --out seed --volume-map etl/data/volume_map.csv --cover-dates etl/data/cover_dates.csv --why-review etl/data/why_review.csv --label-review etl/data/label_review.csv --issue-details etl/data/issue_details.csv --issue-credits etl/data/issue_credits.csv --creator-aliases etl/data/creator_aliases.csv --creator-aliases etl/data/creator_review.csv --book-review etl/data/book_review.csv --book-details etl/data/book_details.csv",
    "enrich": "py etl/enrich_comics.py",
    "enrich:details": "py etl/enrich_comics.py --details",
    "enrich:refresh": "py etl/enrich_comics.py --details --refresh",
    "enrich:books": "py etl/enrich_books.py",
    "sidecars": "py etl/check_sidecars.py",
    "sidecars:fix": "py etl/check_sidecars.py --fix",
    "sidecars:prune-orphans": "py etl/check_sidecars.py --prune-orphans",
    "check:role-outliers": "py etl/check_role_outliers.py",
    "titles:fandom": "py etl/fandom_titles.py",
    "test:views": "node scripts/sql.mjs test etl/test_views.sql",
    "test:etl": "py -m unittest discover -s etl -p \"test_*.py\"",
    "test:tokens": "node scripts/check-tokens.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "seed": "powershell -ExecutionPolicy Bypass -File etl/load.ps1",
    "seed:bash": "bash etl/load.sh",
    "rebuild": "powershell -ExecutionPolicy Bypass -File etl/rebuild.ps1",
    "rebuild:bash": "bash etl/rebuild.sh",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:full": "node scripts/e2e.mjs --full",
    "test:all": "npm run test:tokens && npm run check:migrations && npm run test:db:reset && npm test && npm run test:views && npm run test:etl && npm run test:e2e"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "^3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^25.9.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
