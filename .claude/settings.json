{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx eslint *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run test:all)",
      "Bash(npm run test:all *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(node scripts/test-files.mjs *)",
      "Bash(npm ci)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch -m *)",
      "Bash(git push -u origin task/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr ready *)",
      "Bash(gh run view *)",
      "Bash(git switch *)",
      "Bash(gh workflow run *)",
      "Bash(gh run watch *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/scripts/*)",
      "PowerShell(npx tsc --noEmit)",
      "PowerShell(npx tsc --noEmit *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run test:all)",
      "PowerShell(npm run test:all *)",
      "PowerShell(npm run build)",
      "PowerShell(npm run build *)",
      "PowerShell(node scripts/test-files.mjs *)",
      "PowerShell(npm ci)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout *)",
      "PowerShell(git branch -m *)",
      "PowerShell(git push -u origin task/*)",
      "PowerShell(git push -u origin fix/*)",
      "PowerShell(git push -u origin docs/*)",
      "PowerShell(git push -u origin chore/*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh run view *)",
      "PowerShell(git switch *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run watch *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/scripts/*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(gh workflow run release.yml*)",
      "Bash(npm run rebuild -- -EnvFile .env.live*)",
      "Bash(gh repo delete*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push origin master)",
      "PowerShell(git push origin master *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -fdx *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(git commit -a*)",
      "PowerShell(git commit --all*)",
      "PowerShell(gh workflow run release.yml*)",
      "PowerShell(npm run rebuild -- -EnvFile .env.live*)",
      "PowerShell(.\\etl\\load.ps1 -EnvFile .env.live*)",
      "PowerShell(etl/load.ps1 -EnvFile .env.live*)",
      "Bash(ENV_FILE=.env.live *)",
      "Read(./.env.live)",
      "PowerShell(gh repo delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-large-reads.ps1"],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-protected-paths.ps1"],
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-destructive.ps1"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit-verify.ps1"],
            "timeout": 180
          }
        ]
      }
    ]
  }
}
