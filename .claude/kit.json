{
  "_readme": "Kit v2 config. Read by .claude/hooks/*.ps1, .claude/scripts/*.ps1, the skills, and the agents. Run /customize-kit to fill it in. Empty values disable the related feature. Commands run from the project (or worktree) root via 'cmd.exe /c'. Placeholders: {file} = edited file (verify.fast), {tests} = space-separated test files (testAudit.run), {port} = per-task dev-server port (ui.*).",

  "verify": {
    "sourceExtensions": [".ts", ".tsx", ".mjs"],
    "fast": ["npx tsc --noEmit --pretty false", "npx eslint {file} --max-warnings 0 --no-warn-ignored"],
    "full": ["npx tsc --noEmit", "npm run lint", "npm run test:all", "npm run build"],
    "maxOutputLines": 60
  },

  "protectedPaths": [
    { "pattern": ".env", "reason": "Secrets file" },
    { "pattern": ".env.local", "reason": "Secrets file" },
    { "pattern": ".env.*.local", "reason": "Secrets file" },
    { "pattern": "*.pem", "reason": "Key material" },
    { "pattern": "*.key", "reason": "Key material" },
    { "pattern": "docs/tasks/INDEX.md", "reason": "Generated by .claude/scripts/build-index.ps1; edit task files instead" },
    { "pattern": ".env.live", "reason": "Production connection string; never read or written by Claude" },
    { "pattern": "design/*.dc.html", "reason": "Design source of truth (D-31, D-40); changes come from the design tool" },
    { "pattern": "design/tokens.css", "reason": "Design source of truth (D-31); globals.css follows it, never the reverse" },
    { "pattern": "design/STYLE_GUIDE.md", "reason": "Design source of truth (D-31, D-40); changes come from the design tool" },
    { "pattern": "design/handoff/**", "reason": "Feel-pass handoff (D-40), kept as delivered" },
    { "pattern": "design/screenshots/**", "reason": "Reference screenshots exported from the design tool" },
    { "pattern": "design/archive/**", "reason": "Superseded design sources, kept as delivered" },
    { "pattern": "etl/data/*.xlsx", "reason": "The owner's workbooks; nothing writes back to them" },
    { "pattern": "seed/**", "reason": "Generated by npm run extract; re-extract instead" },
    { "pattern": "backups/**", "reason": "Written by the nightly backup workflow" },
    { "pattern": "src/app/fonts/**", "reason": "Vendored font files (D-40)" }
  ],

  "workflow": {
    "baseBranch": "main",
    "wipLimit": 1,
    "openPullRequests": true,
    "waitForCi": true,
    "maxCiFixRounds": 2,
    "unattendedPermissionMode": "acceptEdits",
    "worktreeSetup": ["npm ci"],
    "worktreeCopyFiles": [".env"]
  },

  "testAudit": {
    "testPathPatterns": ["test/*.test.ts", "test/*.test.tsx", "src/*.test.ts", "src/*.test.tsx", "etl/test_*.py", "etl/test_views.sql"],
    "run": "node scripts/test-files.mjs {tests}"
  },

  "ui": {
    "baseUrl": "http://localhost:{port}",
    "startCommand": "npm run dev -- --port {port}",
    "portBase": 3100,
    "viewports": [
      { "name": "phone-360", "width": 360, "height": 780 },
      { "name": "phone-390", "width": 390, "height": 844 },
      { "name": "phone-412", "width": 412, "height": 915 },
      { "name": "tablet", "width": 768, "height": 1024 },
      { "name": "desktop-1024", "width": 1024, "height": 768 },
      { "name": "desktop-1280", "width": 1280, "height": 800 }
    ],
    "designFiles": [
      "design/mockups.html", "design/Ledger Feel Review.dc.html", "design/LedgerDesktop.dc.html",
      "design/tokens.css", "design/STYLE_GUIDE.md", "design/screenshots/README.md"
    ]
  },

  "_examples": {
    "node_typescript": {
      "verify": {
        "sourceExtensions": [".ts", ".tsx", ".js", ".jsx"],
        "fast": ["npx tsc --noEmit --pretty false", "npx eslint {file}"],
        "full": ["npm run typecheck", "npm run lint", "npm test", "npm run build"]
      },
      "workflow": { "worktreeSetup": ["npm ci"], "worktreeCopyFiles": [".env.local"] },
      "testAudit": { "run": "npx vitest run {tests}" },
      "ui": { "baseUrl": "http://localhost:{port}", "startCommand": "npm run dev -- --port {port}", "designFiles": ["design/mockups.html"] }
    },
    "python": {
      "verify": { "sourceExtensions": [".py"], "fast": ["ruff check {file}"], "full": ["ruff check .", "mypy .", "pytest -q"] },
      "workflow": { "worktreeSetup": ["python -m venv .venv", ".venv\\Scripts\\pip install -r requirements.txt"] },
      "testAudit": { "run": "pytest -q {tests}" }
    },
    "java_gradle": {
      "verify": { "sourceExtensions": [".java", ".kt"], "fast": ["gradlew.bat compileJava -q"], "full": ["gradlew.bat check"] },
      "testAudit": { "run": "gradlew.bat test" }
    },
    "protected_migration": { "pattern": "drizzle/0*.sql", "reason": "Applied migrations are immutable; create a new migration instead" }
  }
}
