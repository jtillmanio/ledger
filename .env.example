# Your DEVELOPMENT database, never production: Neon pooled endpoint. npm run dev,
# rebuild, load, db:push and db:views use it. Production's string goes in
# .env.live (gitignored, same keys: DATABASE_URL, OWNER_ID, LEDGER_LIVE), which only
# `-EnvFile .env.live` reads. START-HERE "Four databases".
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/reading?sslmode=require"

# Who you are. Any stable string; it becomes the first row in users.
OWNER_ID="justin"
OWNER_NAME="Justin"

# Shared passcode for the single-user phase. Replace with real auth when you add people.
APP_PASSCODE="change-me"

# Random 32+ char string used to sign the session cookie.
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# TMDB, for the film and TV watchlist (Phase 8). Free key from your
# themoviedb.org account settings. Server-side only, never exposed to the client.
# Free tier requires TMDB attribution in the UI.
TMDB_API_KEY=""

# Metron, for the comics metadata backfill (etl/enrich_comics.py): cover dates,
# cover URLs, label proposals, story titles, credits. Free account
# at metron.cloud. Use an API token if your account has one, otherwise your
# username and password (HTTP Basic). Read by the script only, never by the app.
METRON_API_TOKEN=""
METRON_USERNAME=""
METRON_PASSWORD=""

# Stays false here: development is always disposable. At cutover set it to true
# in .env.live (START-HERE Step 14); while true, rebuild and load refuse to touch
# that database. Read by those scripts only.
LEDGER_LIVE=false

# A second, disposable database that the tests are allowed to TRUNCATE (R3-02):
# a Neon branch of the ledger, or a local Postgres database named *_test. The
# test scripts read this and only this; they refuse when it is unset or points at
# the same host and database as DATABASE_URL. See START-HERE "Test database".
TEST_DATABASE_URL=""
